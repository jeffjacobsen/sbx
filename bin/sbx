#!/usr/bin/env bash
# The shim. Two directories matter and they are never the same one:
#
#   the INSTALL dir   where the machinery lives (this script's parent)
#   the WORKING dir   the repo being mounted (wherever you invoked sbx)
#
# `just --justfile <install>/justfile` alone would also chdir to the install
# dir, which would make every mount mount THIS repo — the exact coupling the
# whole extraction exists to remove. `--working-directory .` pins it back.
set -euo pipefail

# Resolve symlinks so `ln -s ~/code/sbx/bin/sbx /usr/local/bin/sbx` works.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
done
SBX_HOME="$(cd -P "$(dirname "$src")/.." && pwd)"
export SBX_HOME

# WHERE THE PROVISIONING KEY COMES FROM. It is scoped to an ACCOUNT, exactly
# like the run store, so its home is the machine and not any one repo — a key
# per checkout is the same fragmentation `reap` already suffers from. Sourced
# here rather than via just's dotenv-load, which resolves relative to the
# justfile and would look in the install dir, never in the repo you are mounting.
#
# Order is least-specific first, and NOTHING already exported is overwritten:
# an env var you set on the command line beats a repo, which beats the machine.
_load_env() {
    [ -r "$1" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in ''|'#'*) continue ;; esac
        line="${line#export }"
        key="${line%%=*}"
        case "$key" in *[!A-Za-z0-9_]*|'') continue ;; esac
        # Already set? Leave it. This is what makes the precedence work.
        [ -n "$(eval "printf '%s' \"\${$key:-}\"")" ] && continue
        val="${line#*=}"
        val="${val%\"}"; val="${val#\"}"; val="${val%\'}"; val="${val#\'}"
        export "$key=$val"
    done < "$1"
}
_load_env "${XDG_CONFIG_HOME:-$HOME/.config}/sbx/env"
_load_env "./.env"

command -v just >/dev/null 2>&1 || {
    echo "sbx: just is not installed — https://just.systems" >&2; exit 1; }

# The repo being mounted. Exported rather than left to --working-directory,
# which module recipes do not honour.
SBX_TARGET="$PWD"
export SBX_TARGET

exec just --justfile "$SBX_HOME/justfile" --working-directory . "$@"
